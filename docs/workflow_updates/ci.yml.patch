diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 673a207..44ffef2 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -6,7 +6,12 @@ name: CI - guard tests on push
 
 on:
   push:
-    branches: [main]
+    # Feature branches must be checked too. Only guarding main meant a branch
+    # could accumulate work that had never once run the suite, and the first
+    # signal arrived after merge — when the scheduled pipeline was already
+    # depending on it.
+    branches: ["**"]
+  pull_request:
 
 permissions:
   contents: read
@@ -19,12 +24,19 @@ jobs:
       - uses: actions/setup-python@v5
         with:
           python-version: "3.11"
+          cache: pip
+          cache-dependency-path: requirements.txt
       - name: Install deps (no heavy torch stack)
         run: |
           python -m pip install --upgrade pip
           for i in 1 2 3; do python -m pip install -r requirements.txt && break || { echo retry; sleep 10; }; done
           python -m pip install pytest
       - name: Compile gate (syntax crash-landed commits die here)
-        run: python -m compileall -q src scripts
+        run: python -m compileall -q src scripts tests
       - name: Run test suite
         run: python -m pytest tests/ -q
+      - name: Policy self-check
+        # Prints the active strategy into the run log. When someone changes a
+        # duration or a gate, the diff of this output in CI is the fastest way
+        # to see what it actually did to the pipeline.
+        run: python src/algorithm_policy.py
