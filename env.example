# LLM
GROQ_API_KEY=

# Trend research — Google Trends RSS works without a key. YouTube and Reddit
# use official APIs and are optional; they improve reliability over scraping.
TREND_REGION=US
YOUTUBE_REGION_CODE=US
# 500-episode micro-niche launch. Do not force unrelated daily news trends.
# CONTENT_SERIES controls the writing tone; TOPIC_STRATEGY controls topic
# selection. Two 500-topic launch series are supported:
#   body_glitches  + body_glitch_series  (safe everyday body facts)
#   dark_mystery   + dark_mystery_series (dark psychology / mind-bending /
#                                         unsolved mystery facts — the current
#                                         pivot; tension + curiosity drives the
#                                         watch-to-end completion that the
#                                         saturated body niche was failing on)
CONTENT_SERIES=dark_mystery
TOPIC_STRATEGY=dark_mystery_series
REQUIRE_DAILY_TREND=false

# Autonomous Strategy Engine (src/strategy_engine.py)
# The DS/ML engine aggregates real analytics + ML lever importance and writes a
# decision the pipeline reads before every run (series, cadence, quality gate,
# current growth barrier). Written by scripts/strategy_decision.py and by the
# analytics learning loop; consumed by src/main.py. No action needed to enable
# it — defaults are on. Override the state path only to redirect in tests.
STRATEGY_STATE_PATH=data/strategy_state.json

# Deep Repair 2026 (scripts/deep_repair_2026.py)
# Repairs EVERY uploaded YT/FB/IG video against each platform's 2026 algorithm
# with a high-CTR focus (curiosity titles, UTIS captions, bait removal).
# Ledger prevents re-repairing what's already fixed. Run from GitHub Actions
# (workflow .github/workflows/deep_repair_2026.yml) or locally:
#   python scripts/deep_repair_2026.py            # preview (dry run)
#   python scripts/deep_repair_2026.py --apply    # apply to all
#   python scripts/deep_repair_2026.py --apply --force   # ignore ledger
DEEP_REPAIR_LEDGER_PATH=data/deep_repair_ledger.json
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube OAuth user credentials (service accounts cannot upload to a normal channel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REFRESH_TOKEN=
YT_MADE_FOR_KIDS=false
# Safety first: review every generated science video before making it public.
# With YT_SCHEDULE_PUBLISH=true the upload is private + publishAt, so you get
# a review window and still hit the exact US peak slot automatically.
YT_PRIVACY_STATUS=private
YT_SCHEDULE_PUBLISH=true
ENFORCE_POSTING_GAP=true

# Optional image providers
HF_API_KEY=
GEMINI_API_KEY=
DEEPAI_API_KEY=
MODELSLAB_API_KEY=
REPLICATE_API_TOKEN=
PEXELS_API_KEY=
PIXABAY_API_KEY=
AI_HORDE_API_KEY=

# Optional Facebook. Disabled by default while YouTube videos are privately
# reviewed; Facebook Reels otherwise publish immediately.
FB_ACCESS_TOKEN=
FB_PAGE_ID=
# Graph API version used by the Facebook Reels uploader.
FB_API_VERSION=v23.0
FB_UPLOAD_ENABLED=false
# Optional Instagram Reels cross-post. Requires the same page token to have
# instagram_manage_insights (see GROWTH_SETUP.md). Read by src/main.py and
# src/uploader.py — keep this documented here even though FB_UPLOAD_ENABLED
# is the main switch.
IG_UPLOAD_ENABLED=false
IG_ACCESS_TOKEN=
# Platform-native stagger: publish the Reel this many minutes AFTER the
# YouTube slot (Meta's same-day boost then fires separately instead of
# both platforms seeing identical content at the same minute). Meta rejects
# scheduling on unverified apps — the uploader then degrades to immediate.
FB_STAGGER_MINUTES=120
# Set DRY_RUN=true locally to validate both platform payloads without publishing.
DRY_RUN=false

# ---------------------------------------------------------------------------
# LENGTH & FORMAT
# Durations are owned by src/algorithm_policy.py, which derives them from each
# platform's 2026 completion gate (YouTube ~36s, Meta ~26s) and the measured
# speech rate. Leave TARGET_*_SECONDS and MAX_HOOK_SECONDS EMPTY in normal
# operation — setting them here overrides the policy for every module and is
# how the repo previously ended up optimising for a target nobody re-checked.
# Fill them only for a deliberate, temporary experiment.
TARGET_MIN_SECONDS=
TARGET_MAX_SECONDS=
MAX_HOOK_SECONDS=
# Build a shorter Facebook/Instagram edit from the same assets. Meta widens
# distribution around ~72% watch-through; sending them the YouTube-length cut
# guarantees they see an under-performing video.
META_CUT_ENABLED=true
# loop = end on the loop-back line (clean loop -> replays -> watch time).
# cta  = restore the spoken "follow for more" outro (costs ~8% of runtime).
SPOKEN_CTA_MODE=loop
# Leave empty: the hook gate lives in src/algorithm_policy.py next to the
# scoring scale it is measured against (80 = every structural check passes).
# A number here that was calibrated for an older scorer becomes silently
# unreachable when the scorer changes, and every run then fails its gate.
MIN_HOOK_SCORE=
QUALITY_APPROVAL_THRESHOLD=60
# Natural YouTube clone profile. Use a clean 30–60 second single-speaker
# WAV at VOICE_REFERENCE_PATH for the closest identity match.
CHATTERBOX_TEMPO=0.96
CHATTERBOX_EXAGGERATION=0.35
CHATTERBOX_CFG_WEIGHT=0.70
CHATTERBOX_TEMPERATURE=0.60
# Uses an actual track from assets/music. Leave empty to rotate among all
# supported files there, or set an exact filename to lock one track.
MUSIC_TRACK=
MUSIC_VOLUME=0.07
# US audience voice (all three are read by src/voice_generator.py).
TTS_ENGINE=kokoro
KOKORO_LANG_CODE=a
KOKORO_VOICE=am_adam
ENABLE_SCREENSHOT_FALLBACK=false
VOICE_REFERENCE_PATH=assets/voice_reference.wav
# Durable repository-backed state (committed by GitHub Actions).
VIDEO_HISTORY_PATH=data/video_history.json
UPLOAD_STATE_PATH=data/upload_state.json
# Cross-platform performance store + the weights learned from it. Written by
# the daily Growth Loop workflow and read by the generation pipeline, so each
# run is biased toward whatever is measurably retaining viewers.
PLATFORM_METRICS_PATH=data/platform_metrics.json
GROWTH_STATE_PATH=data/growth_state.json
# How old a video must be before its metrics mean anything, and how often to
# re-read it (Shorts keep accumulating views for weeks, so one fetch is not
# enough).
METRICS_MIN_HOURS=24
METRICS_REFRESH_HOURS=20
VIDEO_TOPIC=
