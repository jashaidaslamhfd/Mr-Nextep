diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 673a207..76a60c8 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -2,11 +2,15 @@ name: CI - guard tests on push
 
 # Every push must pass the test suite BEFORE a scheduled pipeline run can
 # break on it. If a commit would crash the daily pipeline, this fails loud
-# here instead of silently killing uploads at 19:00 Paris time.
+# here instead of silently killing an upload at its New York publish slot.
 
 on:
   push:
     branches: [main]
+  # Also gate pull requests — otherwise a broken branch is only caught after
+  # it has already been merged into main.
+  pull_request:
+    branches: [main]
 
 permissions:
   contents: read
@@ -23,8 +27,9 @@ jobs:
         run: |
           python -m pip install --upgrade pip
           for i in 1 2 3; do python -m pip install -r requirements.txt && break || { echo retry; sleep 10; }; done
-          python -m pip install pytest
       - name: Compile gate (syntax crash-landed commits die here)
-        run: python -m compileall -q src scripts
+        run: python -m compileall -q src scripts tests
+      # Same runner as the production pipeline in main.yml — using pytest here
+      # and unittest there let behaviour diverge between the two gates.
       - name: Run test suite
-        run: python -m pytest tests/ -q
+        run: python -m unittest discover -s tests -v
