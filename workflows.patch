diff --git a/.github/workflows/fb_tuneup.yml b/.github/workflows/fb_tuneup.yml
index 0e53965..4c1009b 100644
--- a/.github/workflows/fb_tuneup.yml
+++ b/.github/workflows/fb_tuneup.yml
@@ -29,13 +29,24 @@ jobs:
           GOOGLE_CLIENT_SECRET: ${{ secrets.GOOGLE_CLIENT_SECRET }}
           REFRESH_TOKEN: ${{ secrets.REFRESH_TOKEN }}
         run: python scripts/fb_page_tuneup.py
-      - name: Persist tune-up report
+      - name: Upload fb-page-tuneup-report report as artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: fb-page-tuneup-report
+          path: data/reports/
+          if-no-files-found: warn
+          retention-days: 90
+
+      # The dated tune-up report goes to artifacts (above); only the durable
+      # done-state ledgers are committed — the tune-up script reads them back
+      # on the next run to avoid redoing work.
+      - name: Persist tune-up done-state
         run: |
           git config user.name "github-actions[bot]"
           git config user.email "github-actions[bot]@users.noreply.github.com"
-          git add data/fb_tuneup_*.json data/fb_thumbs_done.json data/fb_welcome_done.json 2>/dev/null || git add data/fb_tuneup_*.json
+          git add data/fb_thumbs_done.json data/fb_welcome_done.json
           if git diff --cached --quiet; then echo "no changes"; else
-            git commit -m "chore: fb tune-up report [skip ci]"
+            git commit -m "chore: fb tune-up done-state [skip ci]"
             for i in 1 2 3; do
               git pull --rebase --autostash && git push && break
               echo "push race — retry $i"; sleep 8
