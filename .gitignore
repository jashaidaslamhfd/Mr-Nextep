# ===========================
# SKILLOR — .gitignore
# ===========================

# ---- Environment & Secrets ----
.env
.env.*
*.env
.env.local
.env.production

# ---- Auth / token artifacts (CRITICAL — never commit these) ----
# scripts/get_refresh_token.py historically wrote oauth_backup.json into the
# repo root. One careless `git add .` would publish a YouTube refresh token
# (= full account takeover). These patterns close that trap.
oauth_backup.json
client_secrets*.json
client_secret*.json
token*.json
*.token
secrets*.json
**/oauth_backup.json

# Private voice-clone reference — keep locally, never on a public repo.
assets/voice_reference.wav

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Logs ----
*.log
pipeline.log

# ---- Generated Output (videos, audio, images) ----
output/*
!output/.gitkeep

# ---- One-off diagnostic / audit reports ----
# scripts/{fb_page_audit,fb_page_diag,fb_page_tuneup,seo_diag,video_audit}.py
# write a dated JSON dump per run. Nothing reads them back — they are human
# reports. Committing them grew the repo by ~150 KB/week forever, so they now
# land in data/reports/ and are uploaded as workflow artifacts instead.
# Durable STATE (upload_state.json, video_history.json, *_done.json) stays
# tracked in data/ — the pipeline reads those on every run.
data/reports/

# ---- Fallback image pool (generated by scripts/generate_fallback_images.py) ----
assets/fallback_images/*
!assets/fallback_images/.gitkeep

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---- IDE / Editor ----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ---- Temporary files ----
*.tmp
*.bak
*.pyc
*.pyo

# ---- Chatterbox / Kokoro model cache (downloaded at runtime) ----
.cache/
models/
*.ckpt
*.pt
*.bin

# ---- Playwright browser cache ----
pw-browsers/
.playwright/

# ---- Node (if any tooling added later) ----
node_modules/
package-lock.json

